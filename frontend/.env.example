# Copia este archivo como .env.local (nunca lo subas al repositorio).
# backend/drizzle.config.ts también lee este mismo .env.local.

# PostgreSQL (Neon o Supabase). Usa la cadena con SSL: ...?sslmode=require
DATABASE_URL=

# Opcional: BD SOLO de pruebas (con migraciones aplicadas) para tests/reservas.test.ts.
# La prueba crea y borra reservas: nunca apuntes aquí la BD de producción.
# DATABASE_URL_PRUEBAS=

# PayPal (https://developer.paypal.com/dashboard → Apps & Credentials). Sin estas variables
# el pago con PayPal no se ofrece. PAYPAL_ENTORNO: "sandbox" (pruebas) o "live" (producción).
PAYPAL_ENTORNO=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Id del webhook creado en la app de PayPal apuntando a https://<dominio>/api/webhooks/paypal
# con los eventos PAYMENT.CAPTURE.COMPLETED, .DECLINED, .DENIED, .REFUNDED y .REVERSED, y
# PAYMENT.AUTHORIZATION.CREATED y .VOIDED (depósito de garantía).
PAYPAL_WEBHOOK_ID=

# Openpay Colombia (dashboard de Openpay → API Keys). Sin estas variables el pago en pesos
# (tarjeta y PSE) no se ofrece. OPENPAY_ENTORNO: "sandbox" (pruebas) o "produccion".
OPENPAY_ENTORNO=sandbox
OPENPAY_MERCHANT_ID=
# Solo servidor.
OPENPAY_LLAVE_PRIVADA=
# Pública: solo crea tokens de tarjeta en el navegador (llega al cliente por props).
OPENPAY_LLAVE_PUBLICA=
# Usuario y clave de HTTP Basic del webhook (https://<dominio>/api/webhooks/openpay). No vienen
# de Openpay: invéntalos (clave larga y aleatoria) y escríbelos igual al registrar el webhook.
OPENPAY_WEBHOOK_USUARIO=
OPENPAY_WEBHOOK_CLAVE=

# Opcional: URL pública del sitio, para que el banco devuelva al huésped después de PSE.
# En Netlify no hace falta (usa la variable URL que Netlify define).
# SITIO_URL=https://lauburu.example

# Resend (https://resend.com → API Keys). El remitente debe ser de un dominio verificado en
# Resend; para pruebas sin dominio usa "Lauburu <onboarding@resend.dev>", que solo envía al
# correo de tu propia cuenta de Resend. CORREO_ADMIN recibe los documentos de los titulares
# (varios separados por comas).
RESEND_API_KEY=
CORREO_REMITENTE=
CORREO_ADMIN=
